            <ComponentRef Id="CleanupTriLCDir" />
        </Feature>
        <Media Id="1" Cabinet="Data1.cab" EmbedCab="yes" />
        <Property Id="ALLUSERS" Value="1" />
        <Property Id="NEWPRODUCTFOUND" Secure="yes" />
        <Property Id="UPGRADEFOUND" Secure="yes" />
        <Property Id="APPLICATIONFOLDER">
            <RegistrySearch Id="BaseRegSearch" Root="HKLM" Key="SOFTWARE\TriMetaverse\TriCade" Name="Path" Type="raw" Win64="yes" />
        </Property>
        <UI>
            <ProgressText Action="InstallTriLCService">Registering TriLC system service...</ProgressText>
            <ProgressText Action="UninstallTriLCService">Removing TriLC system service...</ProgressText>
            <Dialog Id="TriLCDaemonDlg" X="50" Y="50" Width="370" Height="270" Title="TriCade Bundle — TriLC Service" NoMinimize="yes">
                <Control Id="TriLCCheckbox" Type="CheckBox" X="25" Y="95" Width="320" Height="20" Property="INSTALL_TRILC_SERVICE" Text="Register TriLC as a Windows service (recommended)" CheckBoxValue="1" TabSkip="no" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" TabSkip="no">
                    <Publish Event="NewDialog" Value="WelcomeDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Next" TabSkip="no" Default="yes">
                    <Publish Event="NewDialog" Value="ProgressDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" TabSkip="no" Cancel="yes">
                    <Publish Event="EndDialog" Value="Exit">1</Publish>
                </Control>
                <Control Id="Description" Type="Text" X="25" Y="50" Width="320" Height="40" Text="TriLC is a local AI assistant daemon. Registering as a system service ensures tasks continue running after the IDE closes." TabSkip="yes" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="30" Text="{\WixUI_Font_Title}TriLC Local Controller" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner" TabSkip="yes" Disabled="yes" />
                <Control Id="TriLCAdminNote" Type="Text" X="40" Y="118" Width="290" Height="32" Text="Note: Admin privileges required for service registration. Without admin, registry auto-start will be used instead (launches on login)." TabSkip="yes">
                    <Condition Action="hide">INSTALL_TRILC_SERVICE &lt;&gt; "1"</Condition>
                </Control>
            </Dialog>
        </UI>
        <UIRef Id="WixUI_Minimal" />
        <Upgrade Id="{8F7A2B1C-D3E4-5678-9ABC-DEF012345678}">
            <UpgradeVersion Minimum="0.2.0" Property="NEWPRODUCTFOUND" OnlyDetect="yes" />
            <UpgradeVersion Minimum="0.0.1" Maximum="0.2.0" Property="UPGRADEFOUND" MigrateFeatures="yes" IncludeMinimum="yes" />
        </Upgrade>
        <InstallExecuteSequence>
            <Custom Action="PreventDowngrading" After="FindRelatedProducts">NEWPRODUCTFOUND</Custom>
            <Custom Action="SetARPINSTALLLOCATION" After="CostFinalize" />
            <Custom Action="SetTriLCUninstallPath" Before="UninstallTriLCService">REMOVE ~= "ALL"</Custom>
            <Custom Action="UninstallTriLCService" Before="RemoveFiles">REMOVE ~= "ALL"</Custom>
            <Custom Action="SetTriLCInstallPath" After="InstallFiles">INSTALL_TRILC_SERVICE = "1" AND NOT Installed</Custom>
            <Custom Action="InstallTriLCService" After="SetTriLCInstallPath">INSTALL_TRILC_SERVICE = "1" AND NOT Installed</Custom>
            <RemoveExistingProducts After="InstallInitialize" />
        </InstallExecuteSequence>
        <InstallUISequence>
            <Custom Action="PreventDowngrading" After="FindRelatedProducts">NEWPRODUCTFOUND</Custom>
            <Custom Action="SetARPINSTALLLOCATION" After="CostFinalize" />
        </InstallUISequence>
    </Product>
</Wix>