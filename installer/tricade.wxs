<?xml version="1.0" encoding="UTF-8"?>
<!--
  TriCade Desktop MSI Installer — WiX v3 Source
  =============================================

  Usage:
    1. heat.exe dir <staging> -dr INSTALLFOLDER -cg TriCadeComponents -gg -sfrag -srd -out TriCade-files.wxs
    2. candle.exe installer\tricade.wxs TriCade-files.wxs -dVersion=<version>
    3. light.exe tricade.wixobj TriCade-files.wixobj -out TriCade-<version>-windows.msi

  This file defines the product metadata, UI, and directory structure.
  File components are auto-generated by heat.exe (step 1).
  The heat-generated .wxs is imported via the TriCadeComponents group reference.

  CTO-008-P §5: Build Pipeline
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <!--
    Version is injected via candle.exe -dVersion=... at build time.
    Default "0.0.0.0" ensures the build fails loudly if the parameter is missing.
  -->
  <?ifndef Version?>
  <?error Version preprocessor variable must be set via -dVersion=X.Y.Z ?>
  <?endif?>

  <Product
    Id="*"
    Name="TriCade Desktop"
    Language="1033"
    Version="$(var.Version)"
    Manufacturer="TriMetaverse"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <Package
      InstallerVersion="200"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="TriMetaverse Desktop — TriLC + TriPilot + TriCode bundle" />

    <!--
      Allow major upgrades (uninstall old, install new).
      OnlyMajorUpgrades="yes" prevents downgrade to an older version.
    -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of TriCade is already installed."
      AllowSameVersionUpgrades="yes" />

    <!--
      Media layout: single CAB embedded in the MSI.
    -->
    <MediaTemplate EmbedCab="yes" />

    <!-- ── Directory structure ── -->
    <!--
      INSTALLFOLDER = %ProgramFiles%\TriCade (tool identity, stable across projects).
      Project identity belongs to user data layer (%APPDATA%\TriCade), NOT Program Files.
      StandardDirectory id="ProgramFiles64Folder" maps to 64-bit Program Files.
    -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="TriCade">
          <!-- Subdirectories mirror the staging layout -->
          <Directory Id="ExtensionsDir" Name="extensions" />
          <Directory Id="TriLCDir" Name="trilc" />
          <Directory Id="TriCodeDir" Name="tri-code" />
          <Directory Id="ConfigDir" Name="config" />
          <Directory Id="ScriptsDir" Name="scripts" />
        </Directory>
      </Directory>

      <!-- Start Menu shortcut -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="StartMenuTriCade" Name="TriCade" />
      </Directory>
    </Directory>

    <!-- ── Feature tree ── -->
    <Feature
      Id="MainFeature"
      Title="TriCade Desktop"
      Description="TriMetaverse Desktop bundle (TriLC + TriPilot + TriCode)"
      Level="1"
      ConfigurableDirectory="INSTALLFOLDER"
      AllowAdvertise="no"
      Absent="disallow">
      <ComponentGroupRef Id="TriCadeComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="RegistryEntries" />
      <ComponentRef Id="TrilcPathEnv" />
    </Feature>

    <!-- ── UI sequence ── -->
    <!-- Minimal UI: progress only. For a full wizard, include WixUI_InstallDir. -->
    <UIRef Id="WixUI_Minimal" />

    <!-- ── Properties ── -->
    <Property Id="ARPCONTACT" Value="https://github.com/MoRen9527/TriMetaverse" />
    <Property Id="ARPHELPLINK" Value="https://github.com/MoRen9527/TriMetaverse" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MoRen9527/TriMetaverse" />

    <!-- ── Start Menu shortcut component ── -->
    <DirectoryRef Id="StartMenuTriCade">
      <Component Id="StartMenuShortcut" Guid="B2C3D4E5-F6A7-8901-BCDE-F23456789012">
        <Shortcut
          Id="TriCadeStartMenu"
          Name="TriCade"
          Description="TriMetaverse Desktop"
          Target="[INSTALLFOLDER]scripts\install.bat"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuTriCade" Directory="StartMenuTriCade" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\TriMetaverse\TriCade"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ── Registry key for ARP (Add/Remove Programs) identity ── -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="RegistryEntries" Guid="C3D4E5F6-A7B8-9012-CDEF-345678901234">
        <RegistryValue
          Root="HKLM"
          Key="Software\TriMetaverse\TriCade"
          Name="Version"
          Type="string"
          Value="$(var.Version)"
          KeyPath="yes" />
      </Component>

      <!-- ── PATH registration: [INSTALLFOLDER]trilc on system PATH ── -->
      <!-- WiX Environment removes the entry on uninstall/upgrade automatically. -->
      <Component Id="TrilcPathEnv" Guid="D4E5F6A7-B8C9-0123-DEF4-567890ABCDEF">
        <Environment
          Id="TrilcPathEnvVar"
          Name="PATH"
          Value="[INSTALLFOLDER]trilc"
          Separator=";"
          Action="set"
          Part="last"
          System="yes" />
        <RegistryValue
          Root="HKLM"
          Key="Software\TriMetaverse\TriCade"
          Name="TrilcPathEnv"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

  </Product>
</Wix>
