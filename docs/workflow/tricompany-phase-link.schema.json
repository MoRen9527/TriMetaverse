{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmv/workflow/tricompany-phase-link.schema.json",
  "title": "TriCompanyPhaseLink",
  "description": "经营对象到研发阶段结果的桥接结构。branchId 是通用分支标识，可指向 PRD 分支，也可指向功能、技能或宿主试运行分支；只有当它实际指向 PRD 分支且对象直接治理 DESIGNING 到 ASSURANCE 的实现链时，才应额外采用 docs bootstrap 约定。",
  "type": "object",
  "required": ["relation", "phase", "runId"],
  "properties": {
    "relation": {
      "type": "string",
      "enum": [
        "context-from",
        "input-to",
        "output-of",
        "summarizes",
        "blocks",
        "depends-on"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "DISCOVERY",
        "INTELLIGENCE",
        "DESIGNING",
        "CODING",
        "VERIFY-INTEGRATION",
        "REDTEAM",
        "QA",
        "DEPLOYMENT",
        "ASSURANCE",
        "DELIVERY"
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "branchId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "通用分支标识。对 DESIGNING 到 ASSURANCE 这类 PRD 分支阶段通常应指向具体 PRD 分支；对 skill、schedule 或宿主试运行对象，也可以是 feature/example-skill、feature/example-schedule 之类非 PRD 分支标识。"
    },
    "prdId": {
      "type": "string",
      "description": "当 branchId 实际对应某个 PRD 分支时，建议补充 prdId 以保持产品边界可追溯。"
    },
    "phaseResultRef": {
      "type": "string",
      "pattern": "^docs/runs/[^/]+/(?:[^/]+/)?(?:DISCOVERY|INTELLIGENCE|DESIGNING|CODING|VERIFY-INTEGRATION|REDTEAM|QA|DEPLOYMENT|ASSURANCE|DELIVERY)\\.phase-result\\.json$",
      "description": "稳定落盘的 PhaseResult 路径。若当前 link 指向 PRD 分支实现链，phaseResultRef 应与 branchId 指向的分支保持一致。"
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "DESIGNING",
              "CODING",
              "VERIFY-INTEGRATION",
              "REDTEAM",
              "QA",
              "DEPLOYMENT",
              "ASSURANCE"
            ]
          }
        },
        "required": ["phase"]
      },
      "then": {
        "required": ["branchId"]
      }
    }
  ],
  "additionalProperties": false
}