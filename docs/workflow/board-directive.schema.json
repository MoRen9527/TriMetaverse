{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmv/workflow/board-directive.schema.json",
  "title": "BoardDirective",
  "allOf": [
    {
      "$ref": "tmv/workflow/virtual-company-handoff-envelope.schema.json"
    },
    {
      "type": "object",
      "required": ["objectType", "ownerRole", "timebox", "workflowRefs", "payload"],
      "properties": {
        "objectType": {
          "const": "BOARD_DIRECTIVE"
        },
        "priority": {
          "type": "string",
          "enum": ["high", "critical"]
        },
        "ownerRole": {
          "const": "BoardOversight"
        },
        "timebox": {
          "type": "object",
          "required": ["scope"],
          "properties": {
            "scope": {
              "type": "string",
              "enum": ["monthly", "launch-window", "deadline"]
            },
            "startAt": {
              "type": "string",
              "format": "date-time"
            },
            "endAt": {
              "type": "string",
              "format": "date-time"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "workflowRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "tmv/workflow/virtual-company-phase-link.schema.json"
          }
        },
        "payload": {
          "type": "object",
          "required": [
            "goalVersion",
            "businessTarget",
            "budgetGuardrail",
            "strategicBoundary",
            "effectiveFrom",
            "effectiveTo",
            "issuedBy"
          ],
          "properties": {
            "goalVersion": {
              "type": "string",
              "minLength": 1
            },
            "businessTarget": {
              "type": "string",
              "minLength": 1
            },
            "budgetGuardrail": {
              "type": "string",
              "minLength": 1
            },
            "strategicBoundary": {
              "type": "string",
              "minLength": 1
            },
            "effectiveFrom": {
              "type": "string",
              "format": "date-time"
            },
            "effectiveTo": {
              "type": "string",
              "format": "date-time"
            },
            "issuedBy": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}