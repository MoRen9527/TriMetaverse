{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmv/workflow/phase-result.schema.json",
  "title": "PhaseResult",
  "type": "object",
  "required": [
    "phase",
    "status",
    "startTime",
    "endTime",
    "durationMs",
    "qualityScore",
    "artifacts",
    "errors",
    "summary"
  ],
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "DISCOVERY",
        "INTELLIGENCE",
        "DESIGNING",
        "CODING",
        "VERIFY-INTEGRATION",
        "REDTEAM",
        "QA",
        "DEPLOYMENT",
        "ASSURANCE",
        "DELIVERY"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "blocked", "failed", "completed"]
    },
    "startTime": { "type": "string", "format": "date-time" },
    "endTime": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "qualityScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "required", "exists"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "required": { "type": "boolean" },
          "exists": { "type": "boolean" },
          "checksum": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "high", "critical"] },
          "message": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "review": {
      "type": "object",
      "required": ["status", "version", "reviewId", "approvedBy", "approvedAt", "isInitialRelease", "versionChanged"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "submitted", "approved", "rejected"]
        },
        "version": { "type": "string" },
        "isInitialRelease": { "type": "boolean" },
        "versionChanged": { "type": "boolean" },
        "reviewId": { "type": "string" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "branchId": { "type": "string" },
    "prdId": { "type": "string" },
    "prdDelta": {
      "type": "object",
      "properties": {
        "sourcePhase": {
          "type": "string",
          "enum": ["DISCOVERY", "INTELLIGENCE", "DESIGNING"]
        },
        "whitepaperChanged": { "type": "boolean" },
        "intelligenceChanged": { "type": "boolean" },
        "added": {
          "type": "array",
          "items": { "type": "string" }
        },
        "updated": {
          "type": "array",
          "items": { "type": "string" }
        },
        "removed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "downstreamTriggered": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sourcePhase": { "enum": ["DISCOVERY", "INTELLIGENCE"] }
            },
            "required": ["sourcePhase"]
          },
          "then": {
            "properties": {
              "added": { "maxItems": 0 },
              "removed": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "phase": { "const": "DISCOVERY" } },
        "required": ["phase"]
      },
      "then": {
        "required": ["review"],
        "properties": {
          "review": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "properties": {
                      "isInitialRelease": { "const": true }
                    },
                    "required": ["isInitialRelease"]
                  },
                  {
                    "properties": {
                      "isInitialRelease": { "const": false },
                      "versionChanged": { "const": true }
                    },
                    "required": ["isInitialRelease", "versionChanged"]
                  }
                ]
              }
            ],
            "properties": {
              "status": { "const": "approved" },
              "version": { "type": "string", "pattern": "^WP-v[0-9]+\\.[0-9]+\\.[0-9]+$" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "phase": { "const": "INTELLIGENCE" } },
        "required": ["phase"]
      },
      "then": {
        "required": ["review"],
        "properties": {
          "review": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "properties": {
                      "isInitialRelease": { "const": true }
                    },
                    "required": ["isInitialRelease"]
                  },
                  {
                    "properties": {
                      "isInitialRelease": { "const": false },
                      "versionChanged": { "const": true }
                    },
                    "required": ["isInitialRelease", "versionChanged"]
                  }
                ]
              }
            ],
            "properties": {
              "status": { "const": "approved" },
              "version": { "type": "string", "pattern": "^PRD[0-9A-Za-z_-]+-v[0-9]+\\.[0-9]+\\.[0-9]+$" }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
