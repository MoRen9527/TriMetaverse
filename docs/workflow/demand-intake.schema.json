{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tmv/workflow/demand-intake.schema.json",
  "title": "DemandIntake",
  "allOf": [
    {
      "$ref": "tmv/workflow/virtual-company-handoff-envelope.schema.json"
    },
    {
      "type": "object",
      "required": ["objectType", "ownerRole", "timebox", "workflowRefs", "payload"],
      "properties": {
        "objectType": {
          "const": "DEMAND_INTAKE"
        },
        "ownerRole": {
          "const": "ChiefMarketingOfficer"
        },
        "timebox": {
          "type": "object",
          "required": ["scope"],
          "properties": {
            "scope": {
              "type": "string",
              "enum": ["ad-hoc", "weekly", "monthly"]
            },
            "startAt": {
              "type": "string",
              "format": "date-time"
            },
            "endAt": {
              "type": "string",
              "format": "date-time"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "workflowRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "tmv/workflow/virtual-company-phase-link.schema.json"
          }
        },
        "payload": {
          "type": "object",
          "required": [
            "signalSource",
            "targetAudience",
            "problemStatement",
            "urgency",
            "conversionHypothesis",
            "channelEvidence"
          ],
          "properties": {
            "signalSource": {
              "type": "string",
              "minLength": 1
            },
            "targetAudience": {
              "type": "string",
              "minLength": 1
            },
            "problemStatement": {
              "type": "string",
              "minLength": 1
            },
            "urgency": {
              "type": "string",
              "enum": ["low", "medium", "high", "critical"]
            },
            "conversionHypothesis": {
              "type": "string",
              "minLength": 1
            },
            "channelEvidence": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}