flowchart LR
  user([User\nTelegram / Discord / Slack / Web])

  subgraph local["Local domain (PC / Future NAS)\nVSCodium as Host"]
    webview["Webview UI\n(plan/build + auto-approve toggles)"]
    exthost["VS Code Extension Host\n(bridge + UI state)"]
    vcui["3D Agent Observatory UI\n(Ops+Sim: VibeCraft observability + AgentSims training/eval)"]
    localbus["Local ToolBus / Policy Enforcer\n(file/terminal/MCP)"]
    opencode["OpenCode Coding Worker"]
    videow["Video Factory Worker"]
    vizw["3D/Interactive Demo Worker\n(browser automation/render)"]
    nas[("NAS / Local Archive")]
  end

  subgraph server["Server domain (7×24 online)"]
    subgraph socialfi["SocialFi 服务域独立接入层（目录/仓与 Tripilot 同级）"]
      chad["Channel Adapter\nnormalize message / extract attachments"]
      socialbus["Social Event Bus\nchannel ingress/egress"]
      chresp["Channel Response Adapter\nstream chunks + format"]
    end

    subgraph coreagent["Core-Agent 服务域独立主控（基于 Kode-Agent 重写；目录/仓与 Tripilot 同级）"]
      gateway["Gateway Server (Coordinator)\nSession Entry + Routing"]
      routerq["Session Router + Lane Queue\nConcurrency / Isolation"]
      runner["Agent Runner\nPrompt Builder / History Loader / Context Guard"]
      loop["Agentic Loop\nLLM response -> tool call? -> execute"]
      toolrt["Tool Runtime\nTool A / Tool B / Tool C / Tool D"]
    end

    subgraph tristaciss["Tristaciss（LLM API 平台）"]
      llmgw["LLM Gateway API\nAuth / Routing / Rate Limit / Observability"]
      prov["Provider Manager\nDeepSeek / GLM / OpenRouter ..."]
      streamfb["Streaming + Fallback"]
    end

    serverbus["Server ToolBus / Policy Enforcer\n(network/db/publish)"]
    vcbridge["Observability Bridge\n(audit/toolbus -> observability events; sim -> training/eval events)"]
    crawler["Crawler Agent"]
    social["Social/Forum Agent"]
    publisher["Media Publish Agent"]
    hotstore[("Server HotStore Disk")]
    eventstore[("Audit/Event Store + Manifests")]
  end

  %% User ingress paths
  user --> chad
  user --> webview

  %% Local app path
  webview <--> exthost
  exthost <--> vcui
  exthost <--> gateway

  %% SocialFi to Core-Agent
  chad --> socialbus --> gateway
  loop --> chresp --> user

  %% Core-Agent internals
  gateway --> routerq --> runner --> loop
  loop --> toolrt

  %% LLM path (Core-Agent -> Tristaciss)
  loop --> llmgw --> prov --> streamfb --> loop

  %% Server workers
  gateway --> serverbus
  serverbus --> crawler
  serverbus --> social
  serverbus --> publisher
  crawler --> hotstore
  publisher --> hotstore

  %% Local workers
  gateway --> localbus
  localbus --> opencode
  localbus --> videow
  localbus --> vizw
  localbus --> nas

  %% Artifact sync
  hotstore -. "migrate/pull artifacts" .-> localbus

  %% Audit trail
  gateway --> eventstore
  serverbus --> eventstore
  localbus --> eventstore

  %% VibeCraft-inspired observability
  gateway --> vcbridge
  serverbus --> vcbridge
  localbus --> vcbridge
  eventstore --> vcbridge
  vcbridge --> vcui

  %% References
  ref1["openclaw 参考\nGateway / Agent Runner / Agentic Loop"] -.mapping.-> coreagent
  ref2["Kode-Agent 参考\nClaude Code兼容执行主控"] -.mapping.-> coreagent
  repolayoutcore["Repo Layout 决策\ncore-agent 独立目录（与 Tripilot 同级）"] -.structure.-> coreagent
  repolayoutsocial["Repo Layout 决策\nsocialFi 独立目录（与 Tripilot 同级）"] -.structure.-> socialfi
  ref3["vibecraft 参考\n3D可视化 / 会话编排 / 状态追踪"] -.mapping.-> vcbridge
  ref4["AgentSims 参考\n任务仿真 / Tick循环 / 训练评测沙盒"] -.mapping.-> vcbridge
