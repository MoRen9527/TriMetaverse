  "intake": {
    "objective": "把模型平台任务收敛为 TriStaciss 主导的最小 OpenAI-compatible gateway MVP：补齐 /v1/models，固化 /v1/chat/completions，TriAvatar 仅保留后续最薄 smoke，TriMem 本轮不进入编码。",
    "taskDescription": "以 TriStaciss 为主模块推进最小 OpenAI-compatible 模型网关 MVP：本轮先补齐 GET /v1/models，并用测试固化 POST /v1/chat/completions 的 non-stream 与 stream 合同；TriAvatar 只保留后续最薄聊天 smoke，不切默认入口；TriMem 明确 out-of-scope。",
    "constraints": [
      "首轮编码只允许改动 TriStaciss api-server 与对应测试。",
      "TriAvatar 本轮不切默认聊天入口，只保留后续最薄 smoke 位置。",
      "TriMem 本轮不进入 coding、schema、用户系统与持久化设计。",
      "不得把 /api/chat/stream 的 legacy active path 写成已被替换。"
    ],
    "opportunitySignals": [
      "模型 API 平台需要尽快形成最小可验证合同，而不是继续停留在 docs-only autopilot 交付。",
      "TriStaciss 已有 /v1/chat/completions scaffold，可低成本吸收为首个真实 executable slice。",
      "通过先收敛 /v1/models + /v1/chat/completions，可以为后续 TriAvatar smoke 和 provider 扩展提供稳定后端合同。"
    ],
    "businessModelFit": [
      "符合当前“小成本先跑通可收费闭环、先验证再扩大”的中央商业实验方向。",
      "先验证模型网关合同与 provider 通路，再决定是否继续扩大到更完整平台能力。"
    ],
    "stageFit": [
      "当前切片适合在 Copilot-host + TriDev 执行面下先完成后端合同补齐与源码证据沉淀。",
      "本轮不进入 TriMC 正式宿主改造，也不进入多模块大范围正式上线编排。"
    ],
    "companyContext": [
      "TriCompany 当前 IPD runtime 已要求 coding 及后续阶段必须提交真实源码、测试、部署或运行证据。",
      "TriDev 已具备 knowledge bundle、changed-file/diff evidence、retry loop 与 host parity 基础能力，可作为本轮治理执行面。"
    ],
    "ownerProposal": [
      "Discovery / Intelligence 由 ChiefProductOfficer 收口首轮目标、范围和验收信号。",
      "Designing / Coding 由 ChiefTechnologyOfficer 收口 TriStaciss 后端首刀与验证命令。",
      "完成 TriStaciss backend slice 后，再决定是否启动 TriAvatar 最薄 smoke。"
    ],
    "resourceEnvelope": [
      "本轮资源只覆盖 TriStaciss api-server 后端与 pytest/compileall 验证。",
      "不为 TriMem 用户系统、计费、配额、持久化会话或完整前端改版预留实现资源。"
    ],
    "prerequisites": [
      "保持 BusinessStrategy 已裁定的模块边界：TriStaciss 主战场，TriAvatar 薄联调，TriMem 不入码。",
      "保留旧 docs-only delivery 历史，但不得继续复用旧 completed TriDev run。"
    ],
    "requiredSupport": [
      "ChiefProductOfficer 负责把目标、范围、out-of-scope、成功信号写清。",
      "ChiefTechnologyOfficer 负责把具体文件范围、验证命令和最小验收条件写清。"
    ],
    "expectedOutcomes": [
      "形成一个可执行、可验证、可提交真实工程证据的首个模型网关 coding slice。",
      "让 IPD case 与 TriDev run 从 discovery 重新起步，并在真实代码改动后恢复一致。"
    ],
    "expectedDelivery": "交付一个已回退重写的 IPD case、一个新建并对齐的 TriDev run，以及 TriStaciss /v1/models + /v1/chat/completions 首刀源码与测试证据。",
